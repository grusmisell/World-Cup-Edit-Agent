# Copy this file to .env and fill in your values.

# Required: Anthropic API key for AI moment detection (the agent that picks viral clips).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model used to score/select clips.
CLAUDE_MODEL=claude-sonnet-4-20250514

# Whisper model size for transcription (openai-whisper, runs locally, no API cost).
# tiny | base | small | medium | large
# base is a good speed/quality balance on CPU. Larger = more accurate but slower.
# Weights download to ~/.cache/whisper on first use (base ~139MB, small ~461MB).
WHISPER_MODEL=base

# How many clips to generate per video by default.
DEFAULT_CLIP_COUNT=8

# Min / max clip length in seconds (vertical short-form sweet spot).
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=90

# Pexels (free stock football B-roll for news mode) — https://www.pexels.com/api/
PEXELS_API_KEY=

# ElevenLabs (optional, paid) — human voiceover; replaces edge-tts when set.
# Get a key at https://elevenlabs.io/ (Profile -> API Keys). Pick a voice from your
# ElevenLabs Voice Library (the app shows a picker). Do NOT clone real people's
# voices without consent — it violates ElevenLabs' ToS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# Server
HOST=127.0.0.1
PORT=8001

# Privacy for one-click YouTube uploads: private | unlisted | public
# (Requires bin/youtube_client_secret.json — see README "Publish to YouTube".)
YOUTUBE_PRIVACY=private
